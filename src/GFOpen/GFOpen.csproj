<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny, fast-starting launcher. The folder shortcuts target THIS instead of the full WPF app,
       so a taskbar-pin / double-click just forwards "open <folder>" to the already-running tray
       over the named pipe and exits — no 66MB WPF process spin-up. Falls back to launching the
       full app only when the tray isn't running. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>            <!-- WinExe: no console window flash -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GFOpen</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- NativeAOT: a true native exe (~1.7MB, no .NET runtime, ~15ms cold start). Publishing needs
         the MSVC toolchain (VS "Desktop development with C++") on the BUILD machine only — end users
         just get the finished .exe. Publish from a VS dev environment (vcvars64) so link.exe + its
         libs resolve; see scripts\build-gfopen.bat. -->
    <PublishAot>true</PublishAot>
    <!-- Strip everything a one-shot pipe-forwarder doesn't need, to minimise cold startup. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <NullabilityInfoContextSupport>false</NullabilityInfoContextSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <!-- Match the app's frost icon so the launcher exe isn't a generic icon anywhere it's shown. -->
    <ApplicationIcon>..\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
