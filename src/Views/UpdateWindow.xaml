<Window x:Class="GlassFolders.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check for updates"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        KeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#1B1E24"/>
        <SolidColorBrush x:Key="FgDim" Color="#5C636E"/>
        <SolidColorBrush x:Key="CardBg" Color="#7AFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="CtrlBg" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#4F7CF5"/>
        <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TrackBg" Color="#33000000"/>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource CtrlBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="16" Width="420" Padding="26"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            MouseLeftButtonDown="Card_Drag">
        <StackPanel>
            <!-- Header: app icon + name -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Image x:Name="AppIcon" Width="34" Height="34" VerticalAlignment="Center"
                       Source="/Assets/app.ico"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Glass Folders" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg}"/>
                    <TextBlock x:Name="CurrentVersionText" FontSize="11.5"
                               Foreground="{DynamicResource FgDim}"/>
                </StackPanel>
            </StackPanel>

            <!-- Status line -->
            <TextBlock x:Name="StatusText" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource Fg}"/>
            <TextBlock x:Name="DetailText" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,0"
                       Foreground="{DynamicResource FgDim}"/>

            <!-- Download progress (hidden unless downloading) -->
            <Border x:Name="ProgressTrack" Height="7" CornerRadius="4" Margin="0,16,0,0"
                    Background="{DynamicResource TrackBg}" Visibility="Collapsed"
                    HorizontalAlignment="Stretch">
                <Border x:Name="ProgressFill" CornerRadius="4" Width="0"
                        HorizontalAlignment="Left" Background="{DynamicResource Accent}"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CloseButton" Style="{StaticResource Pill}" Content="Close"
                        Click="Close_Click"/>
                <Button x:Name="ActionButton" Style="{StaticResource Pill}" Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Foreground="{DynamicResource AccentText}" Background="{DynamicResource Accent}"
                        Click="Action_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
