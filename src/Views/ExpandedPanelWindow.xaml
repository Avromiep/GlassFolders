<Window x:Class="GlassFolders.Views.ExpandedPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Topmost="True"
        Opacity="0"
        MouseWheel="Window_MouseWheel"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- Minimal chevron nav button: just an arrow glyph that brightens on hover -->
        <Style x:Key="ChevronButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Foreground" Value="#88202428"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#DD101318"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- App tile button inside the grid -->
        <Style x:Key="AppTile" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tile" Background="Transparent" CornerRadius="14" Padding="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Layered transparent window. We render the frost ourselves (a blurred grab of the
         wallpaper, set as Frost.Background in code) so WPF clips it to the rounded corners
         with no square blur behind. Outer margin leaves room for the drop shadow. -->
    <Grid x:Name="Root" Margin="30">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="OpenScale" CenterX="0" CenterY="0" ScaleX="0.9" ScaleY="0.9"/>
        </Grid.RenderTransform>

        <!-- Liquid glass. Background (the blurred wallpaper) is assigned in code; the Border's
             rounded corners clip it. Tint + specular sheen + lit rim give the glossy look. -->
        <Border x:Name="Frost" CornerRadius="34" Width="470" BorderThickness="1.3"
                Background="Transparent">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                    <GradientStop Color="#E6FFFFFF" Offset="0"/>
                    <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#A0FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="42" ShadowDepth="10" Direction="270"
                                  Opacity="0.4" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- UNIFORM white frost veil over the blurred background; opacity = frostiness.
                     Solid (not gradient), no sheen, so the frost is perfectly even everywhere. -->
                <Border x:Name="TintLayer" CornerRadius="34" IsHitTestVisible="False"
                        Background="#FFFFFFFF"/>

                <DockPanel Margin="22,16,22,14" LastChildFill="True">
                <!-- Title (click to rename) -->
                <Grid DockPanel.Dock="Top" Margin="0,2,0,14">
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="#15181D"
                               HorizontalAlignment="Center" Cursor="Hand" ToolTip="Click to rename"
                               MouseLeftButtonUp="TitleText_Click">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.85" Color="#FFFFFF"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBox x:Name="TitleEdit" FontSize="17" FontWeight="SemiBold" Foreground="#15181D"
                             HorizontalAlignment="Center" TextAlignment="Center" MinWidth="140"
                             Visibility="Collapsed" Padding="6,1" CaretBrush="#15181D"
                             Background="#59FFFFFF" BorderBrush="#66000000" BorderThickness="0,0,0,1.5"
                             KeyDown="TitleEdit_KeyDown" LostKeyboardFocus="TitleEdit_LostFocus"/>
                </Grid>

                <!-- Page dots -->
                <ItemsControl x:Name="Dots" DockPanel.Dock="Bottom" Margin="0,12,0,2"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="7" Height="7" Margin="4,0" Fill="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Grid area with side chevrons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PrevButton" Grid.Column="0" Style="{StaticResource ChevronButton}"
                            Click="Prev_Click">
                        <Path Data="M 12,2 L 2,11 L 12,20" Stroke="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>

                    <ItemsControl x:Name="ItemsGrid" Grid.Column="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="3" Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource ChevronButton}"
                            Click="Next_Click">
                        <Path Data="M 2,2 L 12,11 L 2,20" Stroke="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
