<Window x:Class="GlassFolders.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="540" Height="600" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#1B1E24"/>
        <SolidColorBrush x:Key="FgDim" Color="#5C636E"/>
        <SolidColorBrush x:Key="CardBg" Color="#6EFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#3CFFFFFF"/>
        <SolidColorBrush x:Key="CtrlBg" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#4F7CF5"/>
        <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource CtrlBg}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,0,8,0">
            <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" HorizontalAlignment="Right" Style="{StaticResource Caption}"
                    Content="&#xE8BB;" Click="Close_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="18,4,18,18">
            <!-- About -->
            <Border Style="{StaticResource Section}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/app.ico" Width="40" Height="40" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Liquid Folders" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource Fg}"/>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource FgDim}" FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="Updates" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckButton" Style="{StaticResource AccentBtn}"
                                Content="Check for updates" Click="Check_Click"/>
                        <Button x:Name="DownloadButton" Style="{StaticResource Ghost}" Margin="10,0,0,0"
                                Content="Download" Visibility="Collapsed" Click="Download_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource FgDim}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Backup -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="Import &amp; export" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               Margin="0,0,0,4"/>
                    <TextBlock Foreground="{DynamicResource FgDim}" FontSize="12.5" TextWrapping="Wrap"
                               Text="Export your folders to a file. On another PC, import it and each app that's installed there is re-linked automatically, in the same order."
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ExportButton" Style="{StaticResource Ghost}"
                                Content="Export folders…" Click="Export_Click"/>
                        <Button x:Name="ImportButton" Style="{StaticResource Ghost}" Margin="10,0,0,0"
                                Content="Import folders…" Click="Import_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="BackupStatus" Foreground="{DynamicResource FgDim}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="Diagnostics" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               Margin="0,0,0,4"/>
                    <TextBlock Foreground="{DynamicResource FgDim}" FontSize="12.5" TextWrapping="Wrap"
                               Text="If a folder isn't opening reliably, reproduce it a few times, then save the log and send it over."
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveLogButton" Style="{StaticResource Ghost}"
                                Content="Save log to Desktop" Click="SaveLog_Click"/>
                        <Button x:Name="OpenLogButton" Style="{StaticResource Ghost}" Margin="10,0,0,0"
                                Content="Open log folder" Click="OpenLog_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="DiagStatus" Foreground="{DynamicResource FgDim}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
