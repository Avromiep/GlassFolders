<Window x:Class="GlassFolders.Views.IconFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find app icon"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        KeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#1B1E24"/>
        <SolidColorBrush x:Key="FgDim" Color="#5C636E"/>
        <SolidColorBrush x:Key="CardBg" Color="#7AFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="CtrlBg" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#4F7CF5"/>
        <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PreviewBg" Color="#1A000000"/>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource CtrlBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="16" Width="400" Padding="26"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            MouseLeftButtonDown="Card_Drag">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" FontSize="12.5" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource FgDim}"/>

            <!-- Preview -->
            <Border x:Name="PreviewPanel" Margin="0,18,0,0" Height="168" CornerRadius="12"
                    Background="{DynamicResource PreviewBg}" Visibility="Collapsed">
                <Image x:Name="PreviewImage" Width="128" Height="128"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock x:Name="CaptionText" FontSize="11.5" Margin="0,8,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}"
                       Visibility="Collapsed"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource Pill}" Content="Cancel"
                        Click="Cancel_Click"/>
                <Button x:Name="AnotherButton" Style="{StaticResource Pill}" Margin="10,0,0,0"
                        Content="Try another" Visibility="Collapsed" Click="Another_Click"/>
                <Button x:Name="UseButton" Style="{StaticResource Pill}" Margin="10,0,0,0"
                        Content="Use this icon" Visibility="Collapsed"
                        Foreground="{DynamicResource AccentText}" Background="{DynamicResource Accent}"
                        Click="Use_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
